# ── API Drift Engine — Environment Variables ──────────────────
# Copy to .env and fill in values. Never commit .env to git.

# ── Required ──────────────────────────────────────────────────
DB_USERNAME=apidrift
DB_PASSWORD=your-db-password
AES_ENCRYPTION_KEY=your-32-byte-encryption-key!!  # exactly 32 bytes

# ── Production (Render / Fly.io) ──────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=api_drift
ADMIN_PASSWORD=change-me-in-production
ALERTS_UI_BASE_URL=http://localhost:8080
SPRING_PROFILES_ACTIVE=prod

# ── Optional: CORS ────────────────────────────────────────────
# CORS_ALLOWED_ORIGINS=https://dashboard.example.com,https://admin.example.com

# ── Optional: Alert Integrations ──────────────────────────────
# JIRA_BASE_URL=https://your-company.atlassian.net
# JIRA_PROJECT_KEY=APIDRIFT
# JIRA_AUTH_TOKEN=your-jira-token
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# PAGERDUTY_ROUTING_KEY=your-pd-routing-key

# ── Optional: SonarCloud ──────────────────────────────────────
# SONAR_TOKEN=your-sonarcloud-token

# ── Optional: GitHub Container Registry ───────────────────────
# Used by CI to publish Docker images (set in GitHub Secrets, not here)
# GITHUB_TOKEN=ghp_...
